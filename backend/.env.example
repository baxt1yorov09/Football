# Django Environment
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=django-insecure-change-in-production-key-for-uff-license-system

# Database
DB_NAME=uff_license
DB_USER=uff_user
DB_PASSWORD=uff_password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# SMS Service
SMS_SERVICE=eskiz
ESKIZ_EMAIL=your-email@example.com
ESKIZ_PASSWORD=your-password

# File Storage (S3/R2)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-southeast-1

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@uff.uz

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1
